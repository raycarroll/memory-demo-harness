# API Keys - copy to .env and fill in your keys

# OpenAI (for GPT-4o, GPT-4, etc.)
OPENAI_API_KEY=sk-...

# Anthropic (for Claude models)
# ANTHROPIC_API_KEY=sk-ant-...

# MemoryHub (if using MemoryHub backend)
# MEMORYHUB_API_KEY=mh-...
# MEMORYHUB_URL=http://localhost:8080/mcp/

# mem0 (if using mem0 backend)
# MEM0_API_KEY=...

# Zep (if using Zep backend)
# ZEP_API_KEY=...
